      "id": "contract-en",
      "question": "Can one party unilaterally revoke a contract under Article 147?",
      "expected_article_number": 147,
      "passed": true,
      "result": {
        "answer": "No, a party cannot unilaterally revoke a contract under Article 147. The contract is considered the law between the parties and can only be revoked or altered by mutual consent of both parties or for reasons explicitly provided for by law. However, in cases of exceptional and unpredictable events that make the contractual obligation excessively onerous, a judge may intervene to reduce the obligation to reasonable limits.",
        "sources": [
          "Egyptian Civil Code, Article 147"
        ],
        "insufficient_evidence": false,
        "evidence": [
          {
            "citation": "Egyptian Civil Code, Article 147",
            "quote": "The contract makes the law of the parties. It can be revoked or altered only by mutual consent of the parties or for reasons provided for by law.",
            "language": "en"
          },
          {
            "citation": "Egyptian Civil Code, Article 147",
            "quote": "When, however, as a result of exceptional and unpredictable events of a general character, the performance of the contractual obligation, without becoming impossible, becomes excessively onerous in such way as to threaten the debtor with exorbitant loss, the judge may according to the circumstances, and after taking into consideration the interests of both parties, reduce to reasonable limits, the obligation that has become excessive.",
            "language": "en"
          }
        ],
