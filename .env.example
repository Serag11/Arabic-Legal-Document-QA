# Required for answers (see README, "Get a Google API key")
GOOGLE_API_KEY=

# Optional: comma-separated models tried in order when the configured model's quota runs out
# (each free-tier model has its own daily quota). Evaluation runs never fall back. Blank = off.
GOOGLE_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemini-2.5-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-2.5-flash

# Optional: request tracing in Langfuse (all three, or leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Optional: fraction (0-1) of grounded answers scored for faithfulness in the background.
# Needs `uv sync --group evaluation`; uses extra Google quota. 0 or blank = off.
ONLINE_FAITHFULNESS_SAMPLE_RATE=

# Optional: required only by compose.monitoring.yaml (Grafana admin login)
GRAFANA_ADMIN_PASSWORD=
